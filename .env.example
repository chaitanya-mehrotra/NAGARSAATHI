# NAGARSAATHI V2 Environment Configuration
# Copy this file to .env before starting containers

# Application Mode: development | staging | production
APP_MODE=development

# Database Settings
POSTGRES_DB=nagarsaathi_v2
POSTGRES_USER=nagarsaathi
POSTGRES_PASSWORD=nagarsaathi_secret_local
DATABASE_URL=postgresql+psycopg://nagarsaathi:nagarsaathi_secret_local@db:5432/nagarsaathi_v2

# Security & Sessions
JWT_SECRET=local_dev_jwt_secret_must_change_in_prod_32chars
SESSION_EXPIRE_HOURS=72

# Allowed Origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Media Storage
MEDIA_STORAGE_DIR=/app/.local/media

# Email & Recovery Service (Inbucket Mailbox)
SMTP_HOST=mailbox
SMTP_PORT=2500

# Optional Google OAuth2 Federation (Leave blank for local email/password auth only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# Optional Tile Layer Settings (OpenStreetMap default)
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
