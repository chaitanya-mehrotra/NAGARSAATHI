VITE_API_BASE_URL=http://127.0.0.1:8002
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Backend only
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
YOLO_MODEL_PATH=backend/models/nagarsaathi-combined-v3.pt
MODEL_METADATA_PATH=backend/combined_model_metadata.json
NAGARSAATHI_DEVICE=cpu
# API stores only the worker credential fingerprint; do not put the raw worker key here.
# Run python -m backend.configure_worker to generate an ignored local worker configuration.
NAGARSAATHI_WORKER_TOKEN_SHA256=
# Geometric matching is implemented but defaults to suggestions until field evaluation.
NAGARSAATHI_VISUAL_AUTO_MERGE=0
# The current branch uses SQLite and local registration/login, not Supabase.
# For a single-origin public Docker build, VITE_API_BASE_URL is /api.

