# NAGARSAATHI V2 Environment Configuration
# Copy this file to .env before starting containers

# Application Mode: demo | test | production (demo enables the one-click demo accounts)
APP_MODE=demo

# Database Settings
POSTGRES_DB=nagarsaathi_v2_demo
POSTGRES_USER=nagarsaathi
POSTGRES_PASSWORD=nagarsaathi_secret_local
DATABASE_URL=postgresql+psycopg://nagarsaathi:nagarsaathi_secret_local@127.0.0.1:5432/nagarsaathi_v2_demo

# Photo validation: fixture | human_review | yolo (real detector, needs: pip install -e .[ml])
VALIDATION_PROVIDER=yolo
YOLO_DEVICE=cpu

# Security & Sessions
JWT_SECRET=local_dev_jwt_secret_must_change_in_prod_32chars
SESSION_EXPIRE_HOURS=72

# Allowed Origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Supabase (hosted Postgres + private photo bucket). See docs/SUPABASE.md.
# DATABASE_URL: use the SESSION pooler string (port 5432), starting with postgresql+psycopg://
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<secret key; server only, never in the browser or a commit>
# SUPABASE_STORAGE_BUCKET=complaint-photos
# ALLOW_HOSTED_DEMO_SEED=true   # only to seed demo data into a hosted DEMO database

# Media Storage
STORAGE_ROOT=.local/media

# Email & Recovery Service (Inbucket Mailbox)
SMTP_HOST=127.0.0.1
SMTP_PORT=2500

# Google sign-in (Web application OAuth client). Same ID goes in both variables.
# Authorized JavaScript origins in Google Cloud: http://localhost:5173 (+ your deployed URL)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional Tile Layer Settings (OpenStreetMap default)
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
